{
  "name": "app-sport",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:mobile": "node scripts/build-mobile.cjs",
    "test": "node --test tests/ocr.test.cjs tests/secure-store.test.cjs tests/tcx.test.cjs tests/fit.test.cjs tests/lcd.test.cjs tests/video-scenes.test.cjs tests/vision/*.test.mjs",
    "sync:mobile": "npm run build:mobile && cap sync",
    "test:browser": "node tests/vision/browser.mjs",
    "vendor:ocr": "node scripts/vendor-ocr.cjs",
    "test:video": "node tests/vision/browser.mjs",
    "test:vision": "node --test tests/vision/*.test.mjs",
    "test:vision:real": "node tests/vision/real.mjs",
    "worker:check": "wrangler deploy --dry-run --config backend/wrangler.jsonc --outdir /tmp/app-sport-vision-worker",
    "test:garmin:service": "python3 -m unittest discover -s tests/garmin -p '*_test.py' -v",
    "test:garmin:browser": "node tests/garmin/browser.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@garmin/fitsdk": "21.221.0",
    "esbuild": "0.27.4",
    "miniflare": "4.20260730.0",
    "playwright": "1.62.1",
    "wrangler": "4.168.0"
  }
}
